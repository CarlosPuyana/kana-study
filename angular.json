{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "kana-study": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "*.svg",
                "input": "node_modules/flag-icons/flags/4x3",
                "output": "assets/flags"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "outputPath": {
              "base": "dist/kana-study",
              "browser": "browser"
            },
            "index": "src/index.html"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "manga-manual": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "browser": "src/main.manga-manual.ts",
              "tsConfig": "tsconfig.manga-manual.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "manga-candidate": {
              "browser": "src/main.manga-candidate.ts",
              "tsConfig": "tsconfig.manga-candidate.json",
              "outputPath": {
                "base": "dist/kana-study-candidate",
                "browser": "browser"
              },
              "optimization": true,
              "sourceMap": false,
              "extractLicenses": true
            },
            "puyi-demo": {
              "browser": "src/main.puyi-demo.ts",
              "tsConfig": "tsconfig.puyi-demo.json",
              "index": "src/index.puyi-demo.html",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public/audio/phrase-islands",
                  "output": "audio/phrase-islands"
                }
              ],
              "outputPath": {
                "base": "dist/puyi-demo",
                "browser": "browser"
              },
              "sourceMap": false
            },
            "puyi-editor": {
              "browser": "src/main.puyi-editor.ts",
              "tsConfig": "tsconfig.puyi-editor.json",
              "index": "src/index.puyi-demo.html",
              "assets": [],
              "outputPath": {
                "base": "dist/puyi-editor",
                "browser": "browser"
              },
              "optimization": { "styles": { "inlineCritical": false } },
              "sourceMap": false
            },
            "phrase-admin": {
              "browser": "src/main.phrase-islands-admin.ts",
              "tsConfig": "tsconfig.phrase-admin.json",
              "index": "src/index.phrase-islands-admin.html",
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public/audio/phrase-islands",
                  "output": "audio/phrase-islands"
                }
              ],
              "outputPath": {
                "base": "dist/phrase-islands-admin",
                "browser": "browser"
              },
              "sourceMap": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "manga-manual": {
              "buildTarget": "kana-study:build:manga-manual"
            },
            "production": {
              "buildTarget": "kana-study:build:production"
            },
            "development": {
              "buildTarget": "kana-study:build:development"
            },
            "phrase-admin": {
              "buildTarget": "kana-study:build:development,phrase-admin"
            },
            "puyi-demo": {
              "buildTarget": "kana-study:build:development,puyi-demo"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
